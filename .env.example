# Cloudflare credentials — copy to .env and fill in real values; .env is gitignored

# Terraform (TF_VAR_* prefix is picked up automatically by tofu)
TF_VAR_cloudflare_api_token=
TF_VAR_cloudflare_account_id=

# Wrangler CLI (same token/account, different var names)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
